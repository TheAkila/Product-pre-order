rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product images uploaded from the admin dashboard.
    // Admin access is gated by NEXT_PUBLIC_ADMIN_PASSWORD in the API route
    // (app/api/products/upload/route.ts), the same pattern already used for
    // Firestore writes in this project - there is no Firebase Auth, so these
    // rules can't check "is admin" themselves.
    match /product-images/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*');
    }
  }
}
